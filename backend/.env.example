# GapFill Backend Environment Variables
# Copy this file to backend/.env to configure your free Gmail SMTP and DB

# 1. Gmail SMTP Configuration (Free 500 emails/day)
# Get your 16-letter App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_letter_app_password
SMTP_FROM=GapFill Security <your_email@gmail.com>

# 2. JWT Secret for secure user login tokens
JWT_SECRET=gapfill_super_secure_key_2026_xyz

# 3. Database URL (Optional: defaults to local SQLite gapfill.db)
# DATABASE_URL=sqlite:///gapfill.db
